# ── Redis (비우면 인메모리 백엔드로 자동 폴백) ─────────────
REDIS_URL=redis://localhost:6379/0

# ── 기본 Rate Limit 정책 (Token Bucket) ────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=0

# ── 장애 시 정책 (true=통과 / false=차단) ──────────────────
FAIL_OPEN=true

# ── 알림 채널: none | slack | discord | telegram ───────────
NOTIFY_CHANNEL=none
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN=300
